# Скопируйте в .env и при необходимости поправьте значения.
# Пароли и ключи ниже — только для локальной разработки.

# --- Приложение ---
NODE_ENV=development
# trace | debug | info | warn | error | fatal | silent (по умолчанию: debug в dev, info в production)
LOG_LEVEL=debug

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=tasker
POSTGRES_PASSWORD=tasker
POSTGRES_DB=tasker
POSTGRES_PORT=5433
DATABASE_URL=postgresql://tasker:tasker@localhost:5433/tasker?schema=public

# --- MinIO (docker-compose) ---
MINIO_ROOT_USER=tasker
MINIO_ROOT_PASSWORD=tasker-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- S3-клиент приложения (локально — root-учётка MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tasker
S3_SECRET_ACCESS_KEY=tasker-secret
S3_BUCKET=tasker-attachments
S3_FORCE_PATH_STYLE=true
# Адрес хранилища, видимый браузеру (presigned-ссылки вложений). По умолчанию — S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# Origin-ы приложения, которым MinIO разрешает загрузку из браузера (CORS), через запятую.
# MINIO_CORS_ALLOW_ORIGIN=http://localhost:3000,http://localhost:3001
# Квота файлового хранилища одного пространства (раздел «Документы»), МБ. По умолчанию 1024.
# DOCUMENTS_WORKSPACE_QUOTA_MB=1024

# --- Аутентификация (Better Auth) ---
# Секрет минимум 32 символа. Сгенерировать: openssl rand -base64 32
BETTER_AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000
# Email-адреса через запятую: при первом входе получают глобальную роль admin
ADMIN_EMAILS=admin@example.com

# --- Вход через IdP plwedding ID (обязательно; репозиторий leha-creator/auth) ---
# Своих паролей, подтверждения email и 2FA в Tasker нет: всё это — в IdP. Локально IdP
# запускают на порту 3005: в env IdP BETTER_AUTH_URL=http://localhost:3005,
# OIDC_TASKER_ORIGIN=http://localhost:3000, OIDC_TASKER_CLIENT_SECRET=<тот же секрет>;
# затем pnpm exec next dev -p 3005. Callback: <BETTER_AUTH_URL>/api/auth/callback/plwedding.
OIDC_ISSUER=http://localhost:3005
# OIDC_CLIENT_ID=tasker
OIDC_CLIENT_SECRET=local-tasker-secret-0123456789abcdef

# --- Почта (SMTP; локально — Mailpit из compose.yml, UI http://localhost:8025) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM="Tasker <no-reply@tasker.local>"

# --- GitHub App (необязательно; docs/github.md) ---
# Либо все переменные заданы, либо все пусты: тогда интеграция и привязка GitHub выключены.
# Приватный ключ (.pem) — одной строкой, переводы строк заменить на \n.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# Секрет вебхука (не короче 16 символов) — тот же, что в настройках GitHub App.
# GITHUB_WEBHOOK_SECRET=

# --- Связка с meet (необязательно; docs/meet.md) ---
# Все три заданы или ни одной: тогда созвонов по задачам нет. Секреты не короче 32 символов
# (openssl rand -base64 32), копии — в env meet: TASKER_CONTEXT_SECRET и TASKER_WEBHOOK_SECRET.
# MEET_URL=
# MEET_CONTEXT_SECRET=
# MEET_WEBHOOK_SECRET=

# --- Напоминания о сроке (POST /api/cron/reminders) ---
# Секрет планировщика, не короче 32 символов: openssl rand -hex 32. Пусто — эндпоинт отвечает 404.
# Запустить вручную: pnpm reminders:run
# CRON_SECRET=
# Часовой пояс «сегодня» и «завтра» для сроков. По умолчанию Europe/Moscow.
# REMINDERS_TIMEZONE=Europe/Moscow

# --- Очистка (POST /api/cron/cleanup, тот же CRON_SECRET) ---
# Срок хранения журнала действий, дней (30–3650). По умолчанию 180. Запустить вручную: pnpm cleanup:run
# AUDIT_RETENTION_DAYS=180

# --- Запуск в контейнерах (pnpm app:up, compose.app.yml) ---
# Стек — отдельный compose-проект tasker-app, dev-инфраструктуру не трогает.
# Хост-порты приложения и UI Mailpit; адреса БД, MinIO и Mailpit внутри сети compose задаются
# в compose.app.yml, значения DATABASE_URL / S3_ENDPOINT / SMTP_HOST выше там не используются.
# APP_PORT=3001
# APP_MAILPIT_UI_PORT=8026
# Хост-порт API MinIO контейнерного стека: на него браузер загружает и скачивает вложения.
# APP_MINIO_PORT=9002
