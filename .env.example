# Скопируйте в .env и при необходимости поправьте значения.
# Пароли и ключи ниже — только для локальной разработки.

# --- Приложение ---
NODE_ENV=development
# trace | debug | info | warn | error | fatal | silent (по умолчанию: debug в dev, info в production)
LOG_LEVEL=debug

# --- PostgreSQL ---
DATABASE_URL=postgresql://tasker:tasker@localhost:5432/tasker?schema=public

# --- S3 / MinIO ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tasker
S3_SECRET_ACCESS_KEY=tasker-secret
S3_BUCKET=tasker-attachments
S3_FORCE_PATH_STYLE=true
