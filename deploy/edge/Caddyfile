# Edge-прокси: глобальные настройки и импорт сайтов проектов.
# Каждый проект кладёт свой сайт в /opt/edge/sites/<project>.caddy (в контейнере — /etc/caddy/sites).
{
	log default {
		output stdout
		format json
		level INFO
	}
}

# Пустой каталог sites/ допустим: Caddy стартует без сайтов.
import /etc/caddy/sites/*.caddy
