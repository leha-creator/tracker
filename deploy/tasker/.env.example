# Прод-окружение Tasker: /opt/tasker/.env на сервере (владелец deploy, права 600).
# Создаётся один раз (deploy/bootstrap-app-server.sh генерирует секреты); CI его не трогает.
# Тег образа сюда не пишется — он в /opt/tasker/release.env (TASKER_TAG=sha-xxxxxxx, пишет CI).
#
# Секреты генерировать на сервере, не копировать через чат:
#   openssl rand -hex 32      # BETTER_AUTH_SECRET

# Публичный домен: адрес приложения (BETTER_AUTH_URL). CORS бакета разрешает только его —
# при смене домена infra обновляет правило бакета (storage/cors/tasker-attachments.json).
DOMAIN=tracker.plwedding.ru

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# --- PostgreSQL (общий, leha-creator/infra: postgres/) ---
# Роль и база — tasker, хост postgres:5432 в сети db. Пароль роли берётся из /opt/postgres/.env
# (TASKER_DB_PASSWORD): bootstrap-app-server.sh подставляет его сам, вручную — команда в
# docs/production.md («Переезд на общий Postgres»). Через чат и терминал не передавать.
TASKER_DB_PASSWORD=

# --- Файлы: Yandex Object Storage (бакет и сервисный аккаунт — leha-creator/infra, storage/) ---
# Сервер и браузер ходят по одному адресу; браузер — по presigned-ссылкам, мимо tracker.caddy.
S3_ENDPOINT=https://storage.yandexcloud.net
S3_PUBLIC_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_FORCE_PATH_STYLE=true
S3_BUCKET=tasker-attachments
# Статический ключ сервисного аккаунта tasker-attachments. Вручную не заполнять: ключ создаёт
# и записывает сюда deploy/rotate-storage-key.sh (с рабочей машины, повторный запуск — ротация).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Квота файлового хранилища одного пространства (раздел «Документы»), МБ. По умолчанию 1024.
# DOCUMENTS_WORKSPACE_QUOTA_MB=1024

# --- Аутентификация ---
# Минимум 32 символа. Смена разлогинит всех пользователей.
BETTER_AUTH_SECRET=
# Email-адреса через запятую: при первом входе получают роль admin.
ADMIN_EMAILS=

# --- Вход через IdP plwedding ID (обязательно) ---
# Пароли, подтверждение email и 2FA — в IdP (leha-creator/auth). Секрет — тот же, что
# OIDC_TASKER_CLIENT_SECRET в env IdP; клиент tasker разрешает callback
# https://<DOMAIN>/api/auth/callback/plwedding.
OIDC_ISSUER=https://auth.plwedding.ru
# OIDC_CLIENT_ID=tasker
OIDC_CLIENT_SECRET=

# --- Почта (приглашения, уведомления, письма администратора) ---
# Ящик на домене: Yandex 360 — smtp.yandex.ru, Mail.ru для бизнеса — smtp.mail.ru.
# Порт 465 + SMTP_SECURE=true, пароль — «пароль приложения» из настроек ящика.
# Пока не заполнено, письма не уходят: приглашение создаётся, ссылку передают вручную.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Tasker <no-reply@plwedding.ru>"

# --- GitHub App (необязательно; docs/github.md) ---
# Либо все переменные заданы, либо все пусты: тогда интеграция и привязка GitHub выключены.
# Приватный ключ (.pem) — одной строкой, переводы строк заменить на \n.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Секрет вебхука (не короче 16 символов): тот же, что в настройках GitHub App.
GITHUB_WEBHOOK_SECRET=

# --- Напоминания о сроке ---
# Секрет планировщика (не короче 32 символов): openssl rand -hex 32. Его же передаёт таймер
# tasker-reminders.timer. Пусто — напоминания не рассылаются (эндпоинт отвечает 404).
CRON_SECRET=
# Часовой пояс «сегодня» и «завтра» для сроков. По умолчанию Europe/Moscow.
# REMINDERS_TIMEZONE=Europe/Moscow
# Срок хранения журнала действий, дней (30–3650); чистит tasker-cleanup.timer.
# AUDIT_RETENTION_DAYS=180
