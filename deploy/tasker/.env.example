# Прод-окружение Tasker: /opt/tasker/.env на сервере (владелец deploy, права 600).
# Создаётся один раз (deploy/bootstrap-server.sh генерирует секреты); CI его не трогает.
# Тег образа сюда не пишется — он в /opt/tasker/release.env (TASKER_TAG=sha-xxxxxxx, пишет CI).
#
# Секреты генерировать на сервере, не копировать через чат:
#   openssl rand -hex 24      # пароли Postgres и MinIO
#   openssl rand -hex 32      # BETTER_AUTH_SECRET

# Публичный домен: адрес приложения (BETTER_AUTH_URL) и ссылок на вложения (S3_PUBLIC_ENDPOINT).
DOMAIN=tracker.plwedding.ru

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# --- PostgreSQL ---
POSTGRES_USER=tasker
POSTGRES_PASSWORD=
POSTGRES_DB=tasker

# --- MinIO (учётка root используется и приложением) ---
MINIO_ROOT_USER=tasker
MINIO_ROOT_PASSWORD=
# Должно совпадать с путём бакета в deploy/tasker/tracker.caddy.
S3_BUCKET=tasker-attachments

# --- Аутентификация ---
# Минимум 32 символа. Смена разлогинит всех пользователей.
BETTER_AUTH_SECRET=
# Email-адреса через запятую: при регистрации получают роль admin.
ADMIN_EMAILS=

# --- Почта (приглашения) ---
# Ящик на домене: Yandex 360 — smtp.yandex.ru, Mail.ru для бизнеса — smtp.mail.ru.
# Порт 465 + SMTP_SECURE=true, пароль — «пароль приложения» из настроек ящика.
# Пока не заполнено, приложение работает, но письма приглашений не уходят.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Tasker <no-reply@plwedding.ru>"
