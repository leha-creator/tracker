# Прод-окружение Tasker: /opt/tasker/.env на сервере (владелец deploy, права 600).
# Создаётся один раз (deploy/bootstrap-server.sh генерирует секреты); CI его не трогает.
# Тег образа сюда не пишется — он в /opt/tasker/release.env (TASKER_TAG=sha-xxxxxxx, пишет CI).
#
# Секреты генерировать на сервере, не копировать через чат:
#   openssl rand -hex 24      # пароли Postgres и MinIO
#   openssl rand -hex 32      # BETTER_AUTH_SECRET

# Публичный домен: адрес приложения (BETTER_AUTH_URL) и ссылок на вложения (S3_PUBLIC_ENDPOINT).
DOMAIN=tracker.plwedding.ru

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# --- PostgreSQL ---
POSTGRES_USER=tasker
POSTGRES_PASSWORD=
POSTGRES_DB=tasker

# --- MinIO (учётка root используется и приложением) ---
MINIO_ROOT_USER=tasker
MINIO_ROOT_PASSWORD=
# Должно совпадать с путём бакета в deploy/tasker/tracker.caddy.
S3_BUCKET=tasker-attachments
# Квота файлового хранилища одного пространства (раздел «Документы»), МБ. По умолчанию 1024.
# DOCUMENTS_WORKSPACE_QUOTA_MB=1024

# --- Аутентификация ---
# Минимум 32 символа. Смена разлогинит всех пользователей.
BETTER_AUTH_SECRET=
# Email-адреса через запятую: при регистрации получают роль admin.
ADMIN_EMAILS=
# Обязательное подтверждение email (по умолчанию true): без настроенной почты ниже
# зарегистрироваться нельзя. false — только если почты на сервере нет.
# AUTH_REQUIRE_EMAIL_VERIFICATION=true

# --- Почта (приглашения, подтверждение email, сброс пароля) ---
# Ящик на домене: Yandex 360 — smtp.yandex.ru, Mail.ru для бизнеса — smtp.mail.ru.
# Порт 465 + SMTP_SECURE=true, пароль — «пароль приложения» из настроек ящика.
# Пока не заполнено, письма не уходят: регистрация с подтверждением email и сброс пароля
# не работают.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Tasker <no-reply@plwedding.ru>"

# --- GitHub App (необязательно; docs/github.md) ---
# Либо все переменные заданы, либо все пусты: тогда интеграция и вход через GitHub выключены.
# Приватный ключ (.pem) — одной строкой, переводы строк заменить на \n.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Секрет вебхука (не короче 16 символов): тот же, что в настройках GitHub App.
GITHUB_WEBHOOK_SECRET=

# --- Напоминания о сроке ---
# Секрет планировщика (не короче 32 символов): openssl rand -hex 32. Его же передаёт таймер
# tasker-reminders.timer. Пусто — напоминания не рассылаются (эндпоинт отвечает 404).
CRON_SECRET=
# Часовой пояс «сегодня» и «завтра» для сроков. По умолчанию Europe/Moscow.
# REMINDERS_TIMEZONE=Europe/Moscow
