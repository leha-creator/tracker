// Схема БД Tasker. Конфигурация подключения — в prisma.config.ts.
// Соглашения: модели в PascalCase в единственном числе, поля — camelCase,
// индексы по workspaceId / projectId / assigneeId / dueDate.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ── Аутентификация (Better Auth) ──────────────────────────────────────────────
// Поля соответствуют базовой схеме Better Auth и плагину `admin` (role, banned, banReason,
// banExpires, Session.impersonatedBy). Менять имена полей можно только вместе с конфигом в
// src/shared/auth/auth.ts.

model User {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  /// Глобальная роль: "user" | "admin" (плагин admin Better Auth).
  role             String    @default("user")
  banned           Boolean?  @default(false)
  banReason        String?
  banExpires       DateTime?
  /// Служебный пользователь-агент пространства (модуль agents): без пароля и почты, войти не может.
  /// Поле Better Auth с input: false — проставляет только сервис агентов.
  isAgent          Boolean   @default(false)
  /// Включена ли двухфакторная аутентификация (плагин twoFactor Better Auth). Меняет только плагин
  /// и сброс 2FA в админке.
  twoFactorEnabled Boolean   @default(false)

  sessions   Session[]
  accounts   Account[]
  twoFactors TwoFactor[]

  workspaceMemberships WorkspaceMember[]
  sentInvitations      WorkspaceInvitation[]
  createdProjects      Project[]             @relation("ProjectCreator")
  archivedProjects     Project[]             @relation("ProjectArchiver")
  archivedTasks        Task[]                @relation("TaskArchiver")
  assignedTasks        Task[]                @relation("TaskAssignee")
  createdTasks         Task[]                @relation("TaskCreator")
  taskComments         TaskComment[]         @relation("TaskCommentAuthor")
  taskAttachments      TaskAttachment[]      @relation("TaskAttachmentUploader")
  taskHistoryEntries   TaskHistoryEntry[]    @relation("TaskHistoryActor")
  watchedTasks         TaskWatcher[]
  savedTaskViews       SavedTaskView[]

  profile                 UserProfile?
  notifications           Notification[]           @relation("NotificationRecipient")
  actedNotifications      Notification[]           @relation("NotificationActor")
  notificationPreferences NotificationPreference[]

  createdDocumentFolders DocumentFolder[]   @relation("DocumentFolderCreator")
  createdDocuments       Document[]         @relation("DocumentCreator")
  updatedDocuments       Document[]         @relation("DocumentUpdater")
  createdTaskDocLinks    TaskDocumentLink[] @relation("TaskDocumentLinkCreator")

  connectedGithubInstallations WorkspaceGithubInstallation[] @relation("GithubInstallationConnector")

  apiTokens       ApiToken[]    @relation("ApiTokenOwner")
  issuedApiTokens ApiToken[]    @relation("ApiTokenIssuer")
  mcpActivities   McpActivity[]

  agent                WorkspaceAgent?  @relation("AgentUser")
  responsibleForAgents WorkspaceAgent[] @relation("AgentResponsible")
  createdAgents        WorkspaceAgent[] @relation("AgentCreator")

  auditEventsAsActor        AuditEvent[]       @relation("AuditEventActor")
  auditEventsAsImpersonator AuditEvent[]       @relation("AuditEventImpersonator")
  auditEventsAsTarget       AuditEvent[]       @relation("AuditEventTarget")
  updatedResourceSettings   ResourceSettings[] @relation("ResourceSettingsUpdater")
}

model Session {
  id                String   @id
  token             String   @unique
  expiresAt         DateTime
  ipAddress         String?
  userAgent         String?
  userId            String
  impersonatedBy    String?
  /// Поле плагина organization (activeOrganizationId). Приложение берёт пространство из URL.
  activeWorkspaceId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Хеш пароля (провайдер "credential"). Никогда не отдаётся клиенту и не логируется.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// TOTP-секрет и резервные коды пользователя (плагин twoFactor Better Auth).
/// secret и backupCodes плагин хранит зашифрованными; наружу и в логи они не попадают.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  /// false — 2FA включена, но ещё не подтверждена первым кодом.
  verified                Boolean   @default(true)
  /// Встроенная защита плагина от перебора кодов.
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
}

/// Счётчики rate limit Better Auth для HTTP-эндпоинтов /api/auth/* (rateLimit.storage = "database").
/// Better Auth сам удаляет строки старше своего самого длинного окна.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  /// Время последнего запроса, мс с эпохи.
  lastRequest BigInt
}

/// Счётчики своего rate limit для Server Actions (src/shared/rate-limit): вызовы auth.api.* из
/// Server Actions лимит Better Auth обходят. Отдельно от RateLimit: Better Auth удаляет строки
/// старше 60 с, а окна здесь — до часа. Email в key только хешем.
model ActionRateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

// ── Рабочие пространства (Better Auth organization) ─────────────────────────────
// Модели плагина organization под доменными именами: organization → Workspace,
// member → WorkspaceMember, invitation → WorkspaceInvitation, organizationId → workspaceId.
// Переименования и дополнительные поля (WorkspaceMember.canManageProjects, canManageDocuments) заданы в
// src/shared/auth/auth.ts (schema плагина) — менять только вместе.

model Workspace {
  id             String    @id
  name           String
  slug           String    @unique
  /// Ключ задач (`TSK` → TSK-42): ссылки на задачи в ветках, PR и коммитах GitHub. Уникален глобально,
  /// в верхнем регистре. null — ключ не задан (задачи показываются как #42, привязка GitHub не работает).
  /// Проставляет сервис пространств сразу после создания (поле в плагине с input: false).
  taskKey        String?   @unique
  logo           String?
  /// Ключ предустановленной иконки (shared/entity-icon); null — не выбрана, показывается по id.
  /// Проставляет сервис пространств после создания (поле не входит в схему плагина).
  icon           String?
  metadata       String?
  /// Пространство в архиве (заморожено): доступ только владельцу к настройкам, токены MCP,
  /// вебхуки GitHub и напоминания его пропускают. Поле плагина organization с input: false.
  archivedAt     DateTime?
  /// Квота хранилища документов, МБ; null — по умолчанию ресурса (ResourceSettings, затем env).
  /// Задаёт только администратор ресурса (поле не входит в схему плагина).
  storageQuotaMb Int?
  createdAt      DateTime  @default(now())

  members        WorkspaceMember[]
  invitations    WorkspaceInvitation[]
  projects       Project[]
  tasks          Task[]
  taskCounter    WorkspaceTaskCounter?
  taskLabels     TaskLabel[]
  savedTaskViews SavedTaskView[]
  notifications  Notification[]

  documentFolders DocumentFolder[]
  documents       Document[]
  documentTags    DocumentTag[]

  githubInstallations WorkspaceGithubInstallation[]
  githubRepositories  WorkspaceGithubRepository[]

  apiTokens     ApiToken[]
  agents        WorkspaceAgent[]
  mcpActivities McpActivity[]
  auditEvents   AuditEvent[]
}

model WorkspaceMember {
  id                 String   @id
  workspaceId        String
  userId             String
  /// Роль в пространстве: "owner" | "member".
  role               String   @default("member")
  /// Право управлять проектами и статусами. Владелец имеет его всегда, независимо от флага.
  canManageProjects  Boolean  @default(false)
  /// Право управлять документами (папки, заметки, файлы, теги). Владелец имеет его всегда.
  canManageDocuments Boolean  @default(false)
  createdAt          DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id          String   @id
  workspaceId String
  email       String
  /// Роль, которую получит приглашённый: "owner" | "member".
  role        String?
  /// "pending" | "accepted" | "rejected" | "canceled".
  status      String   @default("pending")
  expiresAt   DateTime
  inviterId   String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter   User      @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email])
}

// ── Проекты и статусы ──────────────────────────────────────────────────────────
// Статус хранит workspaceId и ссылается на проект составным ключом (projectId, workspaceId):
// статус не может оказаться в чужом пространстве.

/// Категория статуса: к выполнению, в работе, выполнено.
enum StatusCategory {
  todo
  in_progress
  done
}

model Project {
  id           String    @id @default(uuid(7)) @db.Uuid
  workspaceId  String
  name         String
  description  String?
  /// Ключ предустановленной иконки (shared/entity-icon); null — не выбрана, показывается по id.
  icon         String?
  createdById  String?
  /// Проект в архиве: скрыт из списков и фильтров, доска только для чтения. null — активный.
  archivedAt   DateTime?
  archivedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace        Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy        User?                    @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  archivedBy       User?                    @relation("ProjectArchiver", fields: [archivedById], references: [id], onDelete: SetNull)
  statuses         ProjectStatus[]
  placements       TaskPlacement[]
  savedTaskViews   SavedTaskView[]
  /// Автосмена статуса по PR (таблица модуля integrations/github).
  githubAutomation GithubProjectAutomation?

  @@unique([workspaceId, name])
  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model ProjectStatus {
  id          String         @id @default(uuid(7)) @db.Uuid
  projectId   String         @db.Uuid
  workspaceId String
  name        String
  category    StatusCategory @default(todo)
  /// Ключ палитры: "gray" | "blue" | "green" | "amber" | "red" | "violet".
  color       String         @default("gray")
  /// Порядок колонки в проекте: 0..n-1, пересчитывается при каждом изменении набора.
  position    Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project                 Project                   @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  placements              TaskPlacement[]
  /// Настройки автосмены статуса, ссылающиеся на этот статус (таблица модуля integrations/github).
  githubAutomationsOpened GithubProjectAutomation[] @relation("GithubAutomationOpened")
  githubAutomationsMerged GithubProjectAutomation[] @relation("GithubAutomationMerged")

  @@unique([projectId, name])
  @@unique([id, projectId])
  @@index([projectId, position])
  @@index([workspaceId])
}

// ── Задачи ─────────────────────────────────────────────────────────────────────
// Статус задачи хранится только в размещении (TaskPlacement): задача может быть в нескольких
// проектах, в каждом — свой статус и позиция. Составные ключи не дают размещению оказаться в
// чужом пространстве или в статусе другого проекта.
// В миграции add_tasks вручную: COLLATE "C" для TaskPlacement.position (дробные ключи
// сравниваются побайтно) и триггер, снимающий ответственного при удалении участника пространства.

/// Приоритет задачи.
/// Порядок значений важен: список задач сортирует по приоритету в порядке enum. Новые — только в конец.
enum TaskPriority {
  none
  low
  medium
  high
  urgent
}

model Task {
  id                String       @id @default(uuid(7)) @db.Uuid
  workspaceId       String
  /// Сквозной номер в пространстве (#42). Выдаётся через WorkspaceTaskCounter, не переиспользуется.
  number            Int
  title             String
  /// Простой текст (rich-text — на этапе «Проектная документация»).
  description       String?
  priority          TaskPriority @default(none)
  dueDate           DateTime?    @db.Date
  /// Участник пространства; снимается триггером при выходе из пространства.
  assigneeId        String?
  createdById       String?
  /// Родительская задача того же пространства; null — задача верхнего уровня. Удаление родителя
  /// удаляет всё поддерево (каскад), глубина и циклы проверяются в модуле tasks (models/task-tree).
  parentId          String?      @db.Uuid
  /// Токен MCP, через который задачу создал агент (пометка «через агента»).
  createdViaTokenId String?      @db.Uuid
  /// Задача в архиве (вместе с поддеревом, общий archivedAt операции): скрыта с досок и из
  /// списков, только чтение. null — активная.
  archivedAt        DateTime?
  archivedById      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  archivedBy         User?                 @relation("TaskArchiver", fields: [archivedById], references: [id], onDelete: SetNull)
  createdViaToken    ApiToken?             @relation("TaskCreatedVia", fields: [createdViaTokenId], references: [id], onDelete: SetNull)
  assignee           User?                 @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy          User?                 @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Составной ключ (parentId, workspaceId): подзадача не может оказаться в чужом пространстве.
  parent             Task?                 @relation("TaskSubtasks", fields: [parentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  subtasks           Task[]                @relation("TaskSubtasks")
  placements         TaskPlacement[]
  comments           TaskComment[]
  attachments        TaskAttachment[]
  /// Метки задачи (срез label модуля tasks).
  labels             TaskLabelAssignment[]
  /// История изменений (срез history модуля tasks).
  history            TaskHistoryEntry[]
  /// Наблюдатели (срез watcher модуля tasks): получают уведомления о комментариях и статусе.
  watchers           TaskWatcher[]
  /// Отправленные напоминания о сроке (срез reminder модуля tasks).
  dueReminders       TaskDueReminder[]
  /// Связи с документами (таблица модуля documents).
  documentLinks      TaskDocumentLink[]
  /// PR, ветки и коммиты GitHub (таблицы модуля integrations/github).
  githubPullRequests TaskPullRequest[]
  githubBranches     TaskGithubBranch[]
  githubCommits      TaskGithubCommit[]

  @@unique([workspaceId, number])
  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, parentId])
  @@index([workspaceId, archivedAt])
  /// Поиск по части названия (ILIKE '%q%': палитра Cmd+K, список); расширение pg_trgm — в миграции.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Task_title_trgm_idx")
}

model TaskPlacement {
  taskId      String   @db.Uuid
  projectId   String   @db.Uuid
  workspaceId String
  statusId    String   @db.Uuid
  /// Дробный ключ порядка в колонке (fractional-indexing). В БД — COLLATE "C".
  position    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task    Task          @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  project Project       @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  /// NoAction (проверка в конце оператора): статус с задачами не удаляется без переноса задач,
  /// а каскадное удаление проекта (статусы + размещения) проходит.
  status  ProjectStatus @relation(fields: [statusId, projectId], references: [id, projectId], onDelete: NoAction)

  @@id([taskId, projectId])
  @@index([projectId, statusId, position])
  @@index([workspaceId])
}

/// Счётчик номеров задач пространства: INSERT … ON CONFLICT DO UPDATE … RETURNING.
model WorkspaceTaskCounter {
  workspaceId String @id
  lastNumber  Int    @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ── Комментарии ────────────────────────────────────────────────────────────────
// Комментарий ссылается на задачу составным ключом (taskId, workspaceId): не может оказаться в
// чужом пространстве. Удаление задачи удаляет её комментарии, удаление пользователя — только автора.

model TaskComment {
  id                String    @id @default(uuid(7)) @db.Uuid
  workspaceId       String
  taskId            String    @db.Uuid
  /// Автор; null — пользователь удалён (комментарий остаётся).
  authorId          String?
  /// Простой текст.
  body              String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  /// Момент последнего изменения текста; null — не редактировался.
  editedAt          DateTime?
  /// Токен MCP, через который комментарий написан (пометка «через агента»).
  createdViaTokenId String?   @db.Uuid

  task            Task      @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  author          User?     @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdViaToken ApiToken? @relation("TaskCommentCreatedVia", fields: [createdViaTokenId], references: [id], onDelete: SetNull)

  attachments TaskAttachment[]

  /// Цель составного FK вложения: файл комментария принадлежит той же задаче.
  @@unique([id, taskId])
  @@index([taskId, createdAt])
  @@index([workspaceId])
}

// ── Метки задач ────────────────────────────────────────────────────────────────
// Метки пространства (как теги документов). Связь — составными FK: метка не попадёт на задачу
// чужого пространства.

model TaskLabel {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String
  name        String
  /// lower(name) — уникальность в пространстве без учёта регистра.
  nameKey     String
  /// Ключ цвета из палитры статусов (STATUS_COLORS).
  color       String
  createdAt   DateTime @default(now())

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignments TaskLabelAssignment[]

  @@unique([workspaceId, nameKey])
  @@unique([id, workspaceId])
}

model TaskLabelAssignment {
  taskId      String @db.Uuid
  labelId     String @db.Uuid
  workspaceId String

  task  Task      @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  label TaskLabel @relation(fields: [labelId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([workspaceId, labelId])
}

// ── Наблюдатели задачи ────────────────────────────────────────────────────────────
// Автор, ответственный, комментаторы и упомянутые подписываются автоматически; агенты — нет.
// При выходе участника из пространства его подписки удаляет триггер (миграция add_task_watchers).
model TaskWatcher {
  taskId      String   @db.Uuid
  userId      String
  workspaceId String
  createdAt   DateTime @default(now())

  task Task @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([workspaceId, userId])
}

// ── Сохранённые фильтры списка задач ──────────────────────────────────────────
// Личные (срез saved-view модуля tasks). Область: список пространства, список проекта или
// «Мои задачи» (без пространства). Уникальность имени в области и CHECK по области — в SQL
// миграции (Prisma не умеет уникальность с NULL). Участник покинул пространство — его фильтры
// там удаляет триггер на WorkspaceMember.

enum SavedTaskViewScope {
  workspace
  project
  mine
}

model SavedTaskView {
  id          String             @id @default(uuid(7)) @db.Uuid
  userId      String
  scope       SavedTaskViewScope
  workspaceId String?
  projectId   String?            @db.Uuid
  /// 1–40 символов.
  name        String
  /// Канонические параметры списка без страницы (serializeTaskListParams), до 2 000 символов.
  params      String
  position    Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([userId, scope, workspaceId, projectId])
}

// ── Напоминания о сроке ───────────────────────────────────────────────────────
// Отметка «напоминание отправлено» (срез reminder модуля tasks). Уникальность по значению срока:
// повторный запуск в тот же день ничего не шлёт, а перенос срока даёт новое напоминание.

enum TaskReminderKind {
  due_soon
  overdue
}

model TaskDueReminder {
  id          String           @id @default(uuid(7)) @db.Uuid
  workspaceId String
  taskId      String           @db.Uuid
  kind        TaskReminderKind
  /// Срок задачи, о котором напомнили.
  dueDate     DateTime         @db.Date
  sentAt      DateTime         @default(now())

  task Task @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([taskId, kind, dueDate])
  @@index([workspaceId])
}

// ── История изменений задачи ──────────────────────────────────────────────────
// Запись пишется в той же транзакции, что и изменение. В data — снимок имён (статусы, проекты,
// участники), чтобы история переживала переименования и удаления; схемы data — models/task-history.

/// Вид изменения. Новые значения — только в конец.
enum TaskHistoryKind {
  created
  title
  description
  priority
  due_date
  assignee
  status
  project_added
  project_removed
  parent
  labels
  archived
  restored
}

model TaskHistoryEntry {
  id          String          @id @default(uuid(7)) @db.Uuid
  workspaceId String
  taskId      String          @db.Uuid
  kind        TaskHistoryKind
  /// Автор; null — система или удалённый пользователь.
  actorId     String?
  /// Токен MCP, через который изменение сделал агент (пометка «через агента»).
  viaTokenId  String?         @db.Uuid
  /// Источник системного изменения: null — пользователь, "github" — автоматизация GitHub.
  source      String?
  data        Json
  createdAt   DateTime        @default(now())
  /// Подряд идущие правки одного поля сливаются в одну запись — время последней правки.
  updatedAt   DateTime        @updatedAt

  task     Task      @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  actor    User?     @relation("TaskHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  viaToken ApiToken? @relation("TaskHistoryVia", fields: [viaTokenId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([workspaceId])
  @@index([actorId])
  @@index([viaTokenId])
}

// ── Вложения ───────────────────────────────────────────────────────────────────
// Файл лежит в S3/MinIO под ключом ws/<workspaceId>/tasks/<taskId>/<attachmentId>, в БД — метаданные.
// Составные FK: вложение не окажется в чужом пространстве (taskId, workspaceId) и в комментарии
// другой задачи (commentId, taskId). Файлы формы нового комментария — черновики: target = comment,
// commentId = null; при отправке комментария они привязываются к нему.
// Удаление задачи или комментария удаляет строки каскадом, объекты хранилища удаляет сервис.

enum AttachmentTarget {
  task
  comment
}

enum AttachmentStatus {
  /// Слот загрузки выдан, файл ещё не подтверждён.
  pending
  /// Файл в хранилище проверен.
  ready
}

model TaskAttachment {
  id          String           @id @default(uuid(7)) @db.Uuid
  workspaceId String
  taskId      String           @db.Uuid
  /// Куда прикреплён файл: блок задачи или комментарий.
  target      AttachmentTarget
  /// Комментарий; null при target = comment — черновик формы, комментарий ещё не отправлен.
  commentId   String?          @db.Uuid
  /// Загрузивший; null — пользователь удалён (файл остаётся).
  uploaderId  String?
  /// Имя для показа и Content-Disposition (санитизировано). В ключе хранилища не используется.
  fileName    String
  /// MIME по расширению из allowlist, а не из браузера.
  contentType String
  size        Int
  storageKey  String           @unique
  status      AttachmentStatus @default(pending)
  createdAt   DateTime         @default(now())
  uploadedAt  DateTime?

  task     Task         @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  comment  TaskComment? @relation(fields: [commentId, taskId], references: [id, taskId], onDelete: Cascade)
  uploader User?        @relation("TaskAttachmentUploader", fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([taskId, target, status, createdAt])
  @@index([commentId])
  @@index([uploaderId, status, createdAt])
  @@index([workspaceId])
}

// ── Профили ────────────────────────────────────────────────────────────────────
// Дополнение к User (модель Better Auth не расширяем). Имя и User.image меняются через
// auth.api.updateUser; в User.image — адрес /api/users/<id>/avatar?v=<версия>.

model UserProfile {
  userId    String   @id
  /// Должность — простой текст.
  position  String?
  /// Описание «о себе» — простой текст.
  bio       String?
  /// Ключ фото в хранилище: users/<userId>/avatar/<id>; null — фото нет.
  avatarKey String?  @unique
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Уведомления ────────────────────────────────────────────────────────────────
// payload — снимок данных на момент события (номер и название задачи, slug пространства,
// имя автора): модуль notifications не читает таблицы задач. Задача и комментарий — ссылки без FK.
// В миграции add_profiles_and_notifications вручную: триггер, удаляющий уведомления
// пространства у вышедшего участника (кроме приглашений).

/// Тип события. Новые значения — только в конец.
enum NotificationType {
  mention
  task_assigned
  task_comment
  workspace_invitation
  /// GitHub: к задаче привязан PR, PR слит, ревью PR (модуль integrations/github).
  pr_linked
  pr_merged
  pr_review
  /// Смена статуса задачи — наблюдателям (модуль tasks).
  task_status_changed
  /// Напоминания о сроке: завтра — ответственному, прошёл — ответственному и наблюдателям.
  task_due_soon
  task_overdue
}

model Notification {
  id           String           @id @default(uuid(7)) @db.Uuid
  /// Получатель.
  userId       String
  workspaceId  String
  type         NotificationType
  /// Автор действия; null — пользователь удалён.
  actorId      String?
  taskId       String?          @db.Uuid
  commentId    String?          @db.Uuid
  invitationId String?
  payload      Json
  /// null — не прочитано.
  readAt       DateTime?
  createdAt    DateTime         @default(now())

  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([workspaceId])
}

/// Настройка канала доставки по типу события. Нет строки — значения по умолчанию из модели.
model NotificationPreference {
  userId    String
  type      NotificationType
  inApp     Boolean
  email     Boolean
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
}

// ── Документы ──────────────────────────────────────────────────────────────────
// Хранилище пространства: папки (дерево), документы двух видов — заметка (Markdown в content)
// и файл (объект S3/MinIO под ключом ws/<workspaceId>/docs/<documentId>), теги и связи с задачами.
// Составные FK (…, workspaceId): папка, документ, тег и связь не окажутся в чужом пространстве.
// Удаление папки удаляет подпапки и документы каскадом, объекты хранилища удаляет сервис.
// В миграции add_documents вручную: уникальность имени папки в родителе (NULLS NOT DISTINCT —
// у корневых папок parentId = null) и CHECK-ограничения полей заметки и файла.

enum DocumentKind {
  /// Markdown-заметка, текст в Document.content.
  note
  /// Загруженный файл в хранилище.
  file
}

enum DocumentFileStatus {
  /// Слот загрузки выдан, файл ещё не подтверждён.
  pending
  /// Файл в хранилище проверен.
  ready
}

model DocumentFolder {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String
  /// Родительская папка; null — корень пространства.
  parentId    String?  @db.Uuid
  name        String
  /// lower(name) — уникальность имени в родителе без учёта регистра.
  nameKey     String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    DocumentFolder?  @relation("DocumentFolderTree", fields: [parentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  children  DocumentFolder[] @relation("DocumentFolderTree")
  createdBy User?            @relation("DocumentFolderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  documents Document[]

  @@unique([id, workspaceId])
  /// Имя папки уникально в родителе. В БД индекс создан вручную с NULLS NOT DISTINCT (миграция
  /// add_documents): Prisma так не умеет, но объявление нужно, чтобы migrate diff не требовал его удалить.
  @@unique([workspaceId, parentId, nameKey])
  @@index([workspaceId, parentId])
  @@index([createdById])
}

model Document {
  id                String              @id @default(uuid(7)) @db.Uuid
  workspaceId       String
  /// Папка; null — корень пространства.
  folderId          String?             @db.Uuid
  kind              DocumentKind
  title             String
  /// lower(title) — поиск и сортировка по названию.
  titleKey          String
  /// Markdown заметки; у файла — null.
  content           String?
  /// Версия для оптимистичной блокировки правки заметки.
  version           Int                 @default(1)
  /// Поля файла (у заметки — null). Имя санитизировано, в ключе хранилища не используется.
  fileName          String?
  extension         String?
  /// MIME по расширению из allowlist, а не из браузера.
  contentType       String?
  size              Int?
  storageKey        String?             @unique
  status            DocumentFileStatus?
  uploadedAt        DateTime?
  createdById       String?
  updatedById       String?
  /// Токен MCP, через который документ создан (пометка «через агента»).
  createdViaTokenId String?             @db.Uuid
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  workspace       Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdViaToken ApiToken?               @relation("DocumentCreatedVia", fields: [createdViaTokenId], references: [id], onDelete: SetNull)
  folder          DocumentFolder?         @relation(fields: [folderId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  createdBy       User?                   @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?                   @relation("DocumentUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  tags            DocumentTagAssignment[]
  taskLinks       TaskDocumentLink[]

  @@unique([id, workspaceId])
  @@index([workspaceId, folderId, titleKey])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, kind, status])
  @@index([createdById, status, createdAt])
  @@index([updatedById])
  /// Поиск по части названия (LIKE '%q%' по titleKey); расширение pg_trgm — в миграции.
  @@index([titleKey(ops: raw("gin_trgm_ops"))], type: Gin, map: "Document_titleKey_trgm_idx")
}

model DocumentTag {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String
  name        String
  /// lower(name) — уникальность в пространстве без учёта регистра.
  nameKey     String
  /// Ключ цвета из палитры DOCUMENT_TAG_COLORS.
  color       String
  createdAt   DateTime @default(now())

  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignments DocumentTagAssignment[]

  @@unique([workspaceId, nameKey])
  @@unique([id, workspaceId])
}

model DocumentTagAssignment {
  documentId  String @db.Uuid
  tagId       String @db.Uuid
  workspaceId String

  document Document    @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  tag      DocumentTag @relation(fields: [tagId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@id([documentId, tagId])
  @@index([tagId])
}

/// Документ, привязанный к задаче (M:N). Таблица модуля documents; удаление задачи снимает связи.
model TaskDocumentLink {
  taskId      String   @db.Uuid
  documentId  String   @db.Uuid
  workspaceId String
  createdById String?
  createdAt   DateTime @default(now())

  task      Task     @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  document  Document @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  createdBy User?    @relation("TaskDocumentLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@id([taskId, documentId])
  @@index([documentId])
  @@index([createdById])
}

// ── GitHub ─────────────────────────────────────────────────────────────────────
// Таблицы модуля integrations/github; ядро (tasks, projects) о них не знает. Id GitHub — BigInt.
// Установка GitHub App и репозитории подключаются к пространствам M:N: один репозиторий может
// обслуживать несколько пространств, ссылку на задачу различает ключ пространства (TSK-42).
// Удаление установки (вебхук installation.deleted) каскадом удаляет репозитории, PR и связи.

/// Состояние PR: open и draft — открыт (черновик отдельно), merged — слит, closed — закрыт без слияния.
enum GithubPrState {
  open
  draft
  merged
  closed
}

/// Итог ревью PR по последнему ревью каждого ревьюера.
enum GithubReviewState {
  none
  approved
  changes_requested
}

/// Итог CI (check suites) для последнего коммита PR.
enum GithubChecksState {
  none
  pending
  success
  failure
}

/// Откуда связь задачи с PR: распознана по ключу или добавлена вручную по ссылке.
enum GithubLinkSource {
  auto
  manual
}

model GithubInstallation {
  /// installation.id в GitHub.
  id           BigInt    @id
  accountId    BigInt
  accountLogin String
  /// "User" | "Organization".
  accountType  String
  /// Установка приостановлена в GitHub: события не обрабатываются.
  suspendedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspaces   WorkspaceGithubInstallation[]
  repositories GithubRepository[]
}

/// Установка, подключённая владельцем к пространству (подключение проверено токеном пользователя).
model WorkspaceGithubInstallation {
  workspaceId    String
  installationId BigInt
  connectedById  String?
  createdAt      DateTime @default(now())

  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installation GithubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  connectedBy  User?              @relation("GithubInstallationConnector", fields: [connectedById], references: [id], onDelete: SetNull)

  @@id([workspaceId, installationId])
  @@index([installationId])
  @@index([connectedById])
}

model GithubRepository {
  /// repository.id в GitHub (не меняется при переименовании).
  id             BigInt   @id
  installationId BigInt
  /// owner/name — обновляется по вебхукам.
  fullName       String
  private        Boolean
  defaultBranch  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  installation GithubInstallation          @relation(fields: [installationId], references: [id], onDelete: Cascade)
  workspaces   WorkspaceGithubRepository[]
  pullRequests GithubPullRequest[]
  checkSuites  GithubCheckSuite[]
  branches     TaskGithubBranch[]
  commits      TaskGithubCommit[]

  @@index([installationId])
}

/// Репозиторий, выбранный владельцем для пространства: только его события привязываются к задачам.
model WorkspaceGithubRepository {
  workspaceId  String
  repositoryId BigInt
  createdAt    DateTime @default(now())

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@id([workspaceId, repositoryId])
  @@index([repositoryId])
}

model GithubPullRequest {
  /// pull_request.id в GitHub.
  id              BigInt            @id
  repositoryId    BigInt
  number          Int
  title           String
  url             String
  state           GithubPrState
  headRef         String
  headSha         String
  authorId        BigInt?
  authorLogin     String?
  reviewState     GithubReviewState @default(none)
  checksState     GithubChecksState @default(none)
  mergedAt        DateTime?
  closedAt        DateTime?
  /// pull_request.updated_at: более старые события не перезаписывают PR (порядок доставки не гарантирован).
  githubUpdatedAt DateTime
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  repository GithubRepository          @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  reviews    GithubPullRequestReview[]
  tasks      TaskPullRequest[]

  @@unique([repositoryId, number])
  @@index([repositoryId, headSha])
}

/// Последнее ревью каждого ревьюера: из них считается GithubPullRequest.reviewState.
model GithubPullRequestReview {
  pullRequestId BigInt
  reviewerId    BigInt
  /// "approved" | "changes_requested" | "commented" | "dismissed".
  state         String
  submittedAt   DateTime

  pullRequest GithubPullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@id([pullRequestId, reviewerId])
}

/// Check suite коммита: из них считается GithubPullRequest.checksState для headSha.
model GithubCheckSuite {
  /// check_suite.id в GitHub.
  id           BigInt   @id
  repositoryId BigInt
  headSha      String
  /// "queued" | "in_progress" | "completed" | …
  status       String
  /// "success" | "failure" | "neutral" | …; null — ещё не завершён.
  conclusion   String?
  updatedAt    DateTime @updatedAt

  repository GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, headSha])
}

/// PR, привязанный к задаче. dismissedAt — отвязан вручную: автоматика его не восстанавливает.
model TaskPullRequest {
  taskId        String           @db.Uuid
  workspaceId   String
  pullRequestId BigInt
  source        GithubLinkSource
  dismissedAt   DateTime?
  createdAt     DateTime         @default(now())

  task        Task              @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  pullRequest GithubPullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@id([taskId, pullRequestId])
  @@index([workspaceId, pullRequestId])
  @@index([pullRequestId])
}

/// Ветка, в имени которой есть ключ задачи. deletedAt — ветку удалили в GitHub (показывается зачёркнутой).
model TaskGithubBranch {
  taskId       String    @db.Uuid
  workspaceId  String
  repositoryId BigInt
  name         String
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  task       Task             @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  repository GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@id([taskId, repositoryId, name])
  @@index([workspaceId])
  @@index([repositoryId, name])
}

/// Коммит задачи: ключ в тексте коммита или в имени ветки push.
model TaskGithubCommit {
  taskId       String   @db.Uuid
  workspaceId  String
  repositoryId BigInt
  sha          String
  /// Первая строка сообщения, не длиннее 200 символов.
  message      String
  url          String
  authorLogin  String?
  committedAt  DateTime
  createdAt    DateTime @default(now())

  task       Task             @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  repository GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@id([taskId, repositoryId, sha])
  @@index([taskId, committedAt])
  @@index([workspaceId])
  @@index([repositoryId])
}

/// Принятые доставки вебхуков (X-GitHub-Delivery): повтор не обрабатывается. Старше 7 дней удаляются.
model GithubWebhookDelivery {
  id         String   @id
  event      String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

/// Автосмена статуса задачи в проекте по событиям PR. Статус удалён — настройка сбрасывается (SetNull).
/// Принадлежность статусов проекту проверяет сервис (FK на статус — только по id).
model GithubProjectAutomation {
  projectId        String   @id @db.Uuid
  workspaceId      String
  prOpenedStatusId String?  @db.Uuid
  prMergedStatusId String?  @db.Uuid
  updatedAt        DateTime @updatedAt

  project        Project        @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  prOpenedStatus ProjectStatus? @relation("GithubAutomationOpened", fields: [prOpenedStatusId], references: [id], onDelete: SetNull)
  prMergedStatus ProjectStatus? @relation("GithubAutomationMerged", fields: [prMergedStatusId], references: [id], onDelete: SetNull)

  @@unique([projectId, workspaceId])
  @@index([workspaceId])
  @@index([prOpenedStatusId])
  @@index([prMergedStatusId])
}

/// GitHub App, созданное из админки по манифесту (одна строка, id = "default").
/// Переменные GITHUB_* в окружении важнее этой записи. Секреты — AES-256-GCM (ключ из BETTER_AUTH_SECRET).
model GithubAppConfig {
  id            String   @id @default("default")
  appId         Int
  slug          String
  name          String
  htmlUrl       String
  /// Владелец приложения на GitHub (пользователь или организация).
  ownerLogin    String?
  /// "User" | "Organization": от него зависит адрес настроек приложения на GitHub.
  ownerType     String?
  clientId      String
  clientSecret  String
  privateKey    String
  webhookSecret String
  /// Вебхук включён при создании (для localhost GitHub его не принимает).
  webhookActive Boolean
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Токены доступа (MCP) ───────────────────────────────────────────────────────
// Токен для агентов (Claude Code через /api/mcp). Личный токен действует с правами пользователя,
// токен агента — с правами агента пространства (userId — служебный пользователь-агент).
// Действует в одном пространстве, админских прав не даёт. Членство проверяется при каждом запросе.

model ApiToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String
  workspaceId String
  /// Название, которое дал пользователь («Claude Code — backend»).
  name        String
  /// Начало токена (`tkr_abcd1234`) — для показа в списке.
  prefix      String
  /// SHA-256 токена (hex). Сам токен не хранится и показывается один раз.
  tokenHash   String    @unique
  /// null — бессрочный.
  expiresAt   DateTime?
  /// Обновляется не чаще раза в минуту.
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  /// Кто выпустил: сам пользователь (личный токен) или владелец пространства (токен агента).
  issuedById  String?
  /// Области: "read" (всегда), "tasks" (задачи, комментарии, вложения), "documents" (документы).
  scopes      String[]  @default(["read", "tasks", "documents"])
  createdAt   DateTime  @default(now())

  user      User      @relation("ApiTokenOwner", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy  User?     @relation("ApiTokenIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdTasks     Task[]             @relation("TaskCreatedVia")
  createdComments  TaskComment[]      @relation("TaskCommentCreatedVia")
  historyEntries   TaskHistoryEntry[] @relation("TaskHistoryVia")
  createdDocuments Document[]         @relation("DocumentCreatedVia")
  activities       McpActivity[]
  auditEvents      AuditEvent[]

  @@index([userId, createdAt])
  @@index([workspaceId])
  @@index([issuedById])
}

// ── Агенты пространства ────────────────────────────────────────────────────────
// Агент — служебный User (isAgent) с членством в одном пространстве (WorkspaceMember, роль member).
// Членство и строку агента создаёт модуль agents в обход плагина organization. Отключение снимает
// членство и отзывает токены, строка User остаётся — авторство в истории сохраняется.

model WorkspaceAgent {
  /// Служебный пользователь агента.
  userId            String    @id
  workspaceId       String
  /// Ответственный участник: ему приходят уведомления, адресованные агенту.
  responsibleUserId String?
  description       String?
  createdById       String?
  /// Отключён: токены отозваны, членство снято.
  disabledAt        DateTime?
  createdAt         DateTime  @default(now())

  user        User      @relation("AgentUser", fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  responsible User?     @relation("AgentResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  createdBy   User?     @relation("AgentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([responsibleUserId])
  @@index([createdById])
}

/// Журнал изменений через MCP. Записи старше 90 дней удаляются по ходу записи.
model McpActivity {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String
  /// Кто действовал: агент или владелец личного токена.
  userId      String
  tokenId     String?  @db.Uuid
  /// Имя инструмента MCP (`change_status`).
  tool        String
  /// Готовая строка для показа («Перевёл TSK-42: К выполнению → В работе»).
  summary     String
  /// Ключ задачи (TSK-42) или id документа.
  targetKey   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     ApiToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@index([workspaceId, userId, createdAt])
  @@index([tokenId, createdAt])
  @@index([createdAt])
}

// ── Журнал действий и настройки ресурса ──────────────────────────────────────────
// Событие пишет src/shared/audit (recordAuditEvent, никогда не бросает), читает модуль audit.
// kind — тип из каталога (shared/audit/audit-catalog.ts): строка, чтобы новый тип не требовал
// миграции; category дублирует каталог для фильтра и индекса. Связи — SetNull: журнал удалённого
// пользователя или пространства остаётся читаемым по снимкам (actorName, data).

enum AuditCategory {
  /// Вход, пароль, 2FA, сессии, токены: видит сам пользователь и администратор.
  security
  /// Пространство, участники, приглашения, агенты, проекты: видят участники пространства.
  workspace
  /// Задачи и документы: видят участники пространства.
  content
  /// Действия администраторов ресурса: видят только администраторы.
  admin
}

model AuditEvent {
  id             String        @id @default(uuid(7)) @db.Uuid
  kind           String
  category       AuditCategory
  /// Автор; null — система или неизвестный.
  actorId        String?
  /// Снимок имени автора на момент события.
  actorName      String?
  /// Администратор, действовавший от имени actorId (имперсонация).
  impersonatorId String?
  /// Токен MCP, через который действовал агент или пользователь.
  viaTokenId     String?       @db.Uuid
  /// Субъект события: кого заблокировали, чей вход не удался.
  targetUserId   String?
  workspaceId    String?
  /// Снимок для показа (ключ и название задачи, название пространства, роль…), схема — по kind.
  data           Json
  /// Только у событий безопасности.
  ip             String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  actor        User?      @relation("AuditEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  impersonator User?      @relation("AuditEventImpersonator", fields: [impersonatorId], references: [id], onDelete: SetNull)
  targetUser   User?      @relation("AuditEventTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  viaToken     ApiToken?  @relation(fields: [viaTokenId], references: [id], onDelete: SetNull)
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([workspaceId, actorId, createdAt])
  @@index([category, createdAt])
  @@index([createdAt])
  @@index([impersonatorId])
  @@index([viaTokenId])
}

enum SignupMode {
  /// Регистрироваться может любой.
  open
  /// Только с активным приглашением в пространство на этот email.
  invite_only
  /// Регистрация закрыта (кроме ADMIN_EMAILS).
  closed
}

/// Настройки ресурса: одна строка id = "default" (src/shared/resource-settings).
model ResourceSettings {
  id                      String     @id @default("default")
  signupMode              SignupMode @default(open)
  /// Разрешённые домены email в нижнем регистре; пусто — любые.
  allowedEmailDomains     String[]   @default([])
  /// Квота хранилища пространства по умолчанию, МБ; null — DOCUMENTS_WORKSPACE_QUOTA_MB.
  defaultWorkspaceQuotaMb Int?
  updatedAt               DateTime   @updatedAt
  updatedById             String?

  updatedBy User? @relation("ResourceSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}
